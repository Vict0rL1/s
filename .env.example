# ---------------------------------------------------------------------------
# Tennis Predictor — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# The Odds API key — used to fetch live bookmaker odds for upcoming matches.
# Get a FREE key at https://the-odds-api.com  (click "Get API Key").
# The free plan allows 500 requests/month. You do NOT need to tell the app which
# plan you are on: remaining + used comes back on every response and IS the plan
# size, so the reserve and the refresh interval are worked out from it.
# If this is left empty, the app falls back to the local sample odds fixtures
# so the dashboard still works offline.
ODDS_API_KEY=

# Regions to request odds for (comma-separated). Common: us, uk, eu, au.
#
# ⚠️ EACH REGION MULTIPLIES THE COST. The Odds API charges one credit per market
# PER REGION, so "eu,uk" makes every call twice as expensive. ONE region on the
# free plan. On a large plan a second region is affordable — it crosses more
# bookmakers, so the de-vigged consensus comes from more prices — and the refresh
# interval adjusts to pay for it automatically.
ODDS_REGIONS=eu

# How often (minutes) the server auto-refreshes live odds while running. Only
# runs when ODDS_API_KEY is set. Set to 0 to disable.
#
# LEAVE THIS COMMENTED OUT unless you want to override the automatic pacing.
# After its first cycle the server knows the size of your plan and what a cycle
# costs, and re-times itself to spend about 60% of the plan per month: roughly
# every 3 days on the 500 free plan, every 2 hours on a 20,000 one.
#
# Setting it here turns that off and the value is honoured exactly. 720 is the
# safe opening bid used until the first cycle has been measured.
# AUTO_REFRESH_MINUTES=720

# Port the REST API listens on.
#
# LEAVE THIS COMMENTED OUT unless you need a specific number. `npm run dev` picks
# a free port before either server starts and hands it to both, so the app runs
# alongside another project that already owns 4000 instead of dying with
# EADDRINUSE. Setting it here PINS the port: if it is busy, the app says so and
# stops rather than moving, because "I told it 4000" deserves an answer about 4000.
# PORT=4000

# Port the web dev server listens on. Same rules as PORT above.
# WEB_PORT=5173

# Base URL of the API for the web frontend's /api proxy.
#
# Normally NOT needed: the proxy follows whatever port the API actually got. Set
# this only to point the frontend at a backend somewhere else entirely.
# VITE_API_BASE=http://localhost:4000
