# Copia este fichero a `.env` (en la RAÍZ del proyecto, al lado de package.json) y rellena
# lo que uses. `.env` está en .gitignore: nunca se sube. Ninguna variable es obligatoria
# para arrancar en local; en producción (NODE_ENV=production) hace falta APP_PASSWORD.
#
# Cuando cambies el .env, reinicia el servidor: solo se lee al arrancar.

# ---------------------------------------------------------------------------
# Cuotas reales — The Odds API (https://the-odds-api.com, plan gratuito 500 créditos/mes)
# ---------------------------------------------------------------------------
# Sin clave la app funciona con cuotas de DEMOSTRACIÓN y lo dice en cada pestaña.
# Si la clave ha estado en un chat, un correo o una captura, GENÉRALA DE NUEVO en tu
# cuenta y pon aquí la nueva: una clave vista es una clave gastada por otro.
ODDS_API_KEY=
# Alias aceptado por compatibilidad (si están las dos, manda ODDS_API_KEY).
# THE_ODDS_API_KEY=
# Regiones de casas: us, us2, uk, eu, au. UNA sola: cada región cuesta créditos aparte.
ODDS_REGIONS=eu
# Minutos entre refrescos automáticos de cuotas (0 lo apaga). Solo cuenta con clave; el
# servidor lo reajusta solo según el tamaño del plan tras el primer ciclo.
AUTO_REFRESH_MINUTES=720
# on | off — partidos y cuotas de demostración cuando no hay reales (por defecto on).
DEMO_FIXTURES=on

# ---------------------------------------------------------------------------
# Acceso (Fase 1)
# ---------------------------------------------------------------------------
# auto (por defecto): pide contraseña solo con NODE_ENV=production. on: siempre. off: nunca
# (prohibido en producción: el servidor no arranca).
APP_AUTH=auto
# Mínimo 8 caracteres. Usa una frase. En Fly: fly secrets set APP_PASSWORD="…"
APP_PASSWORD=
# Red local en desarrollo: sin contraseña, `npm run dev` escucha solo en este ordenador
# (127.0.0.1). Para abrirla en el móvil sin contraseña, a sabiendas: DEV_LAN=on. Con APP_AUTH=on
# también escucha en la red (pide contraseña). HOST fija la dirección a mano.
DEV_LAN=
# Usuario de Basic Auth (no aporta seguridad; existe porque Basic Auth pide un par).
APP_USER=victor
# Segundo factor TOTP (Google Authenticator, Aegis, 1Password…). Genera uno con
#   npm run totp:secreto
# y escanea el QR / pega el secreto en tu app. Vacío = sin segundo factor.
TOTP_SECRET=
# Orígenes ajenos que pueden llamar a la API desde un navegador (lista separada por comas).
# Vacío = ninguno; la pantalla vive en el mismo origen y no lo necesita.
CORS_ORIGINS=
# Tamaño máximo del cuerpo de una petición, en bytes (por defecto 262144 = 256 KB).
BODY_LIMIT_BYTES=

# ---------------------------------------------------------------------------
# Puertos y rutas
# ---------------------------------------------------------------------------
# `npm run dev` elige puertos libres solo y los pasa; esto es para arrancar a mano.
PORT=7374
WEB_PORT=7373
# Dónde viven la base de datos y las descargas (por defecto ./data).
DATA_DIR=
# Dónde está la app construida (por defecto web/dist); solo en producción.
WEB_DIST=
# A qué backend apunta la pantalla en desarrollo si no es el local.
VITE_API_BASE=
# Producción: NODE_ENV=production exige contraseña y app construida. Lo pone el Dockerfile.
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Asistente con modelo de lenguaje (opcional, cuesta dinero por pregunta)
# ---------------------------------------------------------------------------
# Solo ELIGE herramienta entre una lista cerrada; nunca ejecuta SQL ni código. Sin clave,
# el asistente funciona con el enrutador determinista.
ANTHROPIC_API_KEY=
# Modelo para el pipeline de noticias de fútbol (npm run news).
NEWS_MODEL=claude-haiku-4-5-20251001
# Precios por millón de tokens, para `npm run tokens` (entrada / salida, en dólares).
LLM_PRECIO_ENTRADA=
LLM_PRECIO_SALIDA=

# ---------------------------------------------------------------------------
# Medición y estudios
# ---------------------------------------------------------------------------
# Objetivo de latencia de punta a punta del escáner, en ms (por defecto 300000).
LATENCY_TARGET_MS=
# Parámetros del estudio de mitades (npm run study:ht); no tocar salvo para el estudio.
# HT_SHARE=
# HT_RHO=

# ---------------------------------------------------------------------------
# Descarga de la base publicada (npm run fetch-data)
# ---------------------------------------------------------------------------
# Repositorio y etiqueta de la release rodante con la base reconstruida de noche.
DATA_REPO=
DATA_TAG=
DATA_BASE_URL=
# Lo rellena el Dockerfile para que /api/versions diga qué commit corre.
# GIT_COMMIT=

# ---------------------------------------------------------------------------
# Base de datos y copias de seguridad (Fase 2)
# ---------------------------------------------------------------------------
# Nivel de log del servidor (pino): fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# Disposición: `split` (por defecto) = history.db (historia, reconstruible) + ledger.db
# (apuestas, predicciones registradas, precios observados: lo tuyo). `single` = todo en
# tennis.db como antes de la Fase 2, solo por compatibilidad.
DB_LAYOUT=split
# Cada cuántas horas hace el servidor una copia de ledger.db (0 la apaga).
BACKUP_HOURS=24
# (tope: 168 h, siete días; por encima se acota)
# Cada cuántas horas baja el servidor los resultados de los cuatro deportes de equipo
# (update-results en procesos hijo; 0 lo apaga).
RESULTS_REFRESH_HOURS=6
# (tope: 168 h, siete días; por encima se acota)
# Zona horaria de los informes (Fase 6): «cada mañana» es a partir de las 7:00 de esta zona y la
# semana va de lunes a domingo en ella. Sin valor, la del servidor.
# APP_TIMEZONE=Europe/Madrid
# Carpeta local para las copias del libro mayor (por defecto data/backups).
BACKUP_DIR=
# Destino S3 compatible (opcional): bucket, región, endpoint y credenciales.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Notificaciones (Fase 3 — todavía sin uso)
# ---------------------------------------------------------------------------
# Web Push (npm run vapid:generar las creará).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo
# Telegram: token del bot y chat al que escribir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Asistente por Telegram (Fase 8.3, interruptor asistente.telegram): más chats a los que contestar,
# separados por comas, además de TELEGRAM_CHAT_ID. A cualquier otro chat no se le contesta.
TELEGRAM_ASISTENTE_CHATS=
# Correo SMTP.
SMTP_HOST=
SMTP_PORT=587
# 465 = TLS directo; cualquier otro puerto EXIGE STARTTLS. Solo para un relé local sin TLS: SMTP_TLS=off.
SMTP_TLS=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
# Webhook genérico (Discord/Slack).
WEBHOOK_URL=
