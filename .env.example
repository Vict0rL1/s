# ---------------------------------------------------------------------------
# Tennis Predictor — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# The Odds API key — used to fetch live bookmaker odds for upcoming matches.
# Get a FREE key at https://the-odds-api.com  (click "Get API Key").
# The free plan allows 500 requests/month, enough for periodic odds refreshes.
# If this is left empty, the app falls back to the local sample odds fixtures
# so the dashboard still works offline.
ODDS_API_KEY=

# Regions to request odds for (comma-separated). Common: us, uk, eu, au.
# See https://the-odds-api.com/sports-odds-data/bookmaker-apis.html
ODDS_REGIONS=eu,uk

# How often (minutes) the server auto-refreshes live odds while running. Only
# runs when ODDS_API_KEY is set. Set to 0 to disable. The tournament-listing
# call is free; only the per-event odds calls count against the 500/month quota,
# so keep this modest (default 360 = every 6 hours).
AUTO_REFRESH_MINUTES=360

# Port the REST API listens on.
PORT=4000

# Base URL of the API, used by the web frontend (Vite dev proxy targets this).
# Leave as-is for local development.
VITE_API_BASE=http://localhost:4000
