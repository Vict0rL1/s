# TaskFlow — copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se commitea. Está en .gitignore.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API, en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salta RLS por completo. Sólo del lado del servidor, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Canvas (fase 2) -------------------------------------------------------
# Token: Canvas -> Account -> Settings -> "+ New Access Token".
# Ponle fecha de expiración. Si se filtra, revócalo ahí mismo y genera otro.
CANVAS_BASE_URL=https://canvas.sfu.ca/api/v1
CANVAS_TOKEN=

# --- Google Calendar (fase 3) ---------------------------------------------
# Del Google Cloud Console. Estos dos se cargan en Supabase Auth
# (Authentication -> Providers -> Google), no en la app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cron (fase 4) ---------------------------------------------------------
# Cadena aleatoria larga. Protege /api/sync de que cualquiera lo dispare.
# Genérala con: openssl rand -base64 32
CRON_SECRET=

# --- Avisos push (fase 4) --------------------------------------------------
# Par de llaves VAPID. Identifican a TaskFlow ante el servicio de push del
# navegador. Se generan una sola vez, con:
#   npx web-push generate-vapid-keys
# La pública va también al cliente (no es secreta); la privada, nunca.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un mailto: tuyo. Es a quien escribe el servicio de push si algo va mal.
VAPID_SUBJECT=mailto:

# --- Planificador con Claude (fase 4, opcional) ---------------------------
# De console.anthropic.com -> API keys. Es de PAGO y se cobra por uso: cada
# "Planear mi día" cuesta alrededor de un centavo de dólar. La app te dice el
# costo exacto de cada llamada debajo del plan.
# Sin esta variable, el botón no aparece y el resto de la app funciona igual.
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5. Si quieres gastar menos:
# claude-sonnet-5 o claude-haiku-4-5.
PLANNER_MODEL=
