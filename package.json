{
  "name": "tennis-predictor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app + REST API to predict ATP/WTA tennis match results using historical stats, surface-aware Elo ratings, and bookmaker odds.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "seed": "npm run seed --workspace server",
    "update-data": "npm run update-data --workspace server",
    "build": "npm run build --workspace web && npm run typecheck --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
