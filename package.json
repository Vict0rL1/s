{
  "name": "tennis-predictor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app + REST API to predict ATP/WTA tennis match results using historical stats, surface-aware Elo ratings, and bookmaker odds.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "go": "node scripts/go.mjs",
    "test": "npm run test --workspace server && npm run test --workspace web",
    "odds": "npm run odds --workspace server --",
    "deploy": "node scripts/deploy.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "seed": "npm run seed --workspace server",
    "update-data": "npm run update-data --workspace server --",
    "update-all": "node scripts/update-all.mjs",
    "fetch-data": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/fetch-data.mjs",
    "fetch-flags": "node scripts/fetch-flags.mjs",
    "check-publishable": "cross-env NODE_OPTIONS=\"--experimental-sqlite --disable-warning=ExperimentalWarning\" tsx scripts/check-publishable.mjs",
    "backtest": "npm run backtest --workspace server --",
    "benchmark:report": "npm run benchmark:report --workspace server --",
    "model:report": "npm run model:report --workspace server --",
    "reproduce": "npm run reproduce --workspace server --",
    "model:history": "npm run model:history --workspace server --",
    "shadow:report": "npm run shadow:report --workspace server --",
    "build": "npm run build --workspace web && npm run typecheck --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --config .oxlintrc.json server/src web/src scripts",
    "update-results": "npm run update-results --workspace server --",
    "update-data:bb": "npm run update-data:bb --workspace server --",
    "backtest:bb": "npm run backtest:bb --workspace server --",
    "seed:bb": "npm run seed:bb --workspace server --",
    "update-data:fb": "npm run update-data:fb --workspace server --",
    "update-squads:fb": "npm run update-squads:fb --workspace server --",
    "backtest:fb": "npm run backtest:fb --workspace server --",
    "backtest:bsb": "npm run backtest:bsb --workspace server --",
    "update-data:bsb": "npm run update-data:bsb --workspace server --",
    "verify:bsb": "npm run verify:bsb --workspace server --",
    "audit": "npm run audit --workspace server --",
    "update-data:naf": "npm run update-data:naf --workspace server --",
    "backtest:naf": "npm run backtest:naf --workspace server --",
    "phone": "node scripts/phone.mjs",
    "dev:fixed": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "verify:data": "npm run verify:data --workspace server --",
    "study:ht": "npm run study:ht --workspace server --",
    "study:ht-val": "npm run study:ht-val --workspace server --",
    "doctor": "npm run doctor --workspace server --",
    "study:sigma": "npm run study:sigma --workspace server --",
    "study:devig": "npm run study:devig --workspace server --",
    "study:features": "npm run study:features --workspace server --",
    "study:baselines": "npm run study:baselines --workspace server --",
    "experiments": "npm run experiments --workspace server --",
    "seed:experiments": "npm run seed:experiments --workspace server --",
    "study:calibration": "npm run study:calibration --workspace server --",
    "staking": "npm run staking --workspace server --",
    "study:dc": "npm run study:dc --workspace server --",
    "study:postprocess": "npm run study:postprocess --workspace server --",
    "study:thin": "npm run study:thin --workspace server --",
    "news": "npm run news --workspace server --",
    "latency": "npm run latency --workspace server --",
    "study:correlation": "npm run study:correlation --workspace server --",
    "study:live": "npm run study:live --workspace server --",
    "study:points": "npm run study:points --workspace server --",
    "study:ablation": "npm run study:ablation --workspace server --",
    "study:home-elo": "npm run study:home-elo --workspace server --",
    "study:home-bb": "npm run study:home-bb --workspace server --",
    "study:nfl-spread": "npm run study:nfl-spread --workspace server --",
    "study:params-bb": "npm run study:params-bb --workspace server --",
    "study:params-bsb": "npm run study:params-bsb --workspace server --",
    "auto": "node scripts/auto.mjs",
    "demo": "node scripts/demo.mjs",
    "paper": "npm run paper --workspace server --",
    "tokens": "npm run tokens --workspace server --",
    "ahorro": "node scripts/ahorro.mjs",
    "prepare": "node -e \"const{execSync}=require('node:child_process');const fs=require('node:fs');if(fs.existsSync('.git'))try{execSync('git config core.hooksPath .githooks')}catch{}\"",
    "secret-scan": "node scripts/secret-scan.mjs --tracked",
    "totp:secreto": "npm run totp:secreto --workspace server --",
    "db:migrate": "npm run db:migrate --workspace server --",
    "db:export-history": "npm run db:export-history --workspace server --",
    "db:explain": "npm run db:explain --workspace server --",
    "backup": "npm run backup --workspace server --",
    "restore": "npm run restore --workspace server --",
    "odds:retention": "npm run odds:retention --workspace server --",
    "clubelo": "npm run clubelo --workspace server --",
    "bullpen": "npm run bullpen --workspace server --",
    "policy": "npm run policy --workspace server --",
    "export": "npm run export --workspace server --",
    "jobs": "npm run jobs --workspace server --",
    "vapid:generar": "npm run vapid:generar --workspace server --",
    "study": "npm run study --workspace server --",
    "help": "node scripts/help.mjs",
    "setup": "node scripts/setup.mjs",
    "clave": "node scripts/clave.mjs",
    "e2e": "npm run e2e --workspace web --",
    "carga": "node scripts/carga.mjs",
    "carga:ci": "node scripts/carga.mjs --arrancar --presupuesto",
    "update-data:nhl": "npm run update-data:nhl --workspace server --",
    "backtest:nhl": "npm run backtest:nhl --workspace server --",
    "update-data:ufc": "npm run update-data:ufc --workspace server --",
    "backtest:ufc": "npm run backtest:ufc --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "oxlint": "^1.80.0"
  }
}
