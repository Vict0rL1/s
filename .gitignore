# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Environment / secrets — never commit real API keys
.env
.env.local
.env.*.local

# Local data store and downloaded raw data (regenerated by `npm run update-data` / `npm run seed`)
data/tennis.db
data/tennis.db-*
data/raw/*
!data/raw/.gitkeep
# The seed dataset under data/seed/ IS committed on purpose (offline demo data)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
data/.dev-ports.json
# Generado por `npm run auto`: lleva dentro la ruta absoluta de ESTA máquina, así que
# commitearlo le daría a otra persona un guion que apunta a una carpeta que no existe.
data/auto-actualizar.sh
data/tennis.db.backup-*
