# Copy this file to `.env` and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Both are safe to ship in a
# client app: the anon key only grants what your row-level security policies allow.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
